<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="vertex-global">
  <Description>Fallback: gemini-3-flash-preview in global region (only available via global endpoint)</Description>

  <HTTPTargetConnection>
    <!-- global endpoint — gemini-3-flash-preview is ONLY available here -->
    <URL>https://aiplatform.googleapis.com</URL>
    <Properties>
      <Property name="request.retain.headers">Authorization,Content-Type,x-cymbal-app</Property>
    </Properties>
  </HTTPTargetConnection>

  <!-- Rewrite target URL to gemini-3-flash-preview in global region -->
  <PreFlow name="PreFlow">
    <Request>
      <Step><Name>AM-RewriteFallbackPath</Name></Step>
    </Request>
    <Response/>
  </PreFlow>
</TargetEndpoint>
