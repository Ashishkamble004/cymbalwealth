<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage name="AM-SetFallbackFlag">
  <AssignTo createNew="false" type="request"/>
  <Set>
    <Headers>
      <Header name="x-cymbal-fallback-triggered">true</Header>
      <Header name="x-cymbal-fallback-reason">{response.status.code}</Header>
    </Headers>
  </Set>
  <AssignVariable>
    <Name>fallback_triggered</Name>
    <Value>true</Value>
  </AssignVariable>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
