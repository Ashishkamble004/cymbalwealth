<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Inject Google service account bearer token for Vertex AI auth -->
<AssignMessage name="AM-InjectServiceAccountToken">
  <AssignTo createNew="false" type="request"/>
  <Set>
    <Headers>
      <!-- The token is populated by a ServiceCallout to the metadata server,
           or passed through from the ADK agent's own auth (for Vertex AI backend).
           ApigeeLlm already handles Vertex AI auth headers — this policy ensures
           they are forwarded correctly. -->
      <Header name="x-cymbal-routed-by">apigee-llm-gateway</Header>
      <Header name="x-cymbal-primary-model">gemini-2.5-flash</Header>
      <Header name="x-cymbal-fallback-model">gemini-3-flash-preview-global</Header>
    </Headers>
  </Set>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
