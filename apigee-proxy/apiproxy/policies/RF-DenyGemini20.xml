<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault name="RF-DenyGemini20">
  <Condition>proxy.pathsuffix Contains "gemini-2.0"</Condition>
  <FaultResponse>
    <Set>
      <StatusCode>400</StatusCode>
      <ReasonPhrase>Model Not Permitted</ReasonPhrase>
      <Payload contentType="application/json">{"error": "gemini-2.0 models are not permitted. Use gemini-2.5-flash (primary) or gemini-3-flash-preview/global (fallback)."}</Payload>
    </Set>
  </FaultResponse>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
