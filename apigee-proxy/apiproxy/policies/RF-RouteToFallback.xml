<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Re-route the request to the global fallback target -->
<RaiseFault name="RF-RouteToFallback">
  <!-- This policy clears the fault and forces re-routing to vertex-global target.
       The actual re-routing is done by the RouteRule in the proxy endpoint
       checking the fallback_triggered variable. -->
  <FaultResponse>
    <Set>
      <StatusCode>200</StatusCode>
    </Set>
  </FaultResponse>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
