<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Assign analytics variables as response headers for Apigee Analytics custom dimensions -->
<AssignMessage name="SC-RecordAnalytics">
  <AssignTo createNew="false" type="response"/>
  <Set>
    <Headers>
      <Header name="x-cymbal-prompt-tokens">{prompt_tokens}</Header>
      <Header name="x-cymbal-completion-tokens">{completion_tokens}</Header>
      <Header name="x-cymbal-total-tokens">{total_tokens}</Header>
      <Header name="x-cymbal-fallback">{fallback_triggered}</Header>
      <Header name="x-cymbal-target">{target.name}</Header>
    </Headers>
  </Set>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
