# =============================================================================
# Wealth Management Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Gemini AI ---
GEMINI_API_KEY=                        # From Google AI Studio (https://aistudio.google.com)

# --- Database (PostgreSQL) ---
DB_URL=postgresql://wealthuser:changeme@localhost:5432/wealthdb

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Google Cloud Storage ---
GCS_KYC_BUCKET=                        # Cloud Storage bucket for KYC docs
GCS_VOICE_BUCKET=                      # Cloud Storage bucket for voice transcripts

# --- GCP ---
GCP_PROJECT_ID=                        # Your GCP project ID
GCP_REGION=asia-south1

# --- Application ---
BANK_NAME=Prestige Private Bank

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
